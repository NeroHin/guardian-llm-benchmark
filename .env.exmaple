# ==========================
# Guardian LLM Benchmark env
# ==========================

# [Required when using provider=openrouter in model-experiment/execution.py]
# Get key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [Optional] OpenRouter request metadata headers
# If OPENROUTER_HTTP_REFERER is empty, code will fallback to HTTP_REFERER.
OPENROUTER_HTTP_REFERER=https://your-app.example.com
HTTP_REFERER=

# If OPENROUTER_TITLE is empty, code will fallback to X_OPENROUTER_TITLE.
OPENROUTER_TITLE=guardian-llm-benchmark
X_OPENROUTER_TITLE=

# [Optional] Async concurrency for OpenRouter benchmark requests
OPENROUTER_CONCURRENCY=5

# [Optional for utils/generate_non_pii_with_openai.py]
# You can use either OPENAI_API_KEY or OPENROUTER_API_KEY.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [Optional] Hugging Face Xet global overrides
# Note: execution.py also supports per-model settings.hf_xet in model_specs.yaml.
# Env vars below are used when not overridden by model settings.
HF_XET_HIGH_PERFORMANCE=1
HF_XET_NUM_CONCURRENT_RANGE_GETS=32
HF_XET_RECONSTRUCT_WRITE_SEQUENTIALLY=0
# HF_XET_CHUNK_CACHE_SIZE_BYTES=10000000000
# HF_XET_SHARD_CACHE_SIZE_LIMIT=4000000000

# [Optional] Hugging Face cache paths (recommended to place on SSD/NVMe)
# HF_HOME=/path/to/.cache/huggingface
# HF_HUB_CACHE=/path/to/.cache/huggingface/hub
# HF_XET_CACHE=/path/to/.cache/huggingface/xet
